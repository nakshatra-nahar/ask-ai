{
  "name": "ask-ai-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/server.js",
    "start": "node --env-file-if-exists=../.env src/server.js",
    "seed": "node src/store/seed-cli.js",
    "smoke": "node eval/smoke.js",
    "oracle": "node eval/oracle.js",
    "retrieval": "node eval/retrieval.js",
    "eval": "node --env-file-if-exists=../.env eval/run.js",
    "test": "node eval/smoke.js && node eval/filters.test.js && node eval/agent-loop.test.js && node eval/oracle.js && node eval/retrieval.js",
    "report": "node eval/report.js",
    "catalog": "node src/catalog/docgen.js",
    "filters": "node eval/filters.test.js",
    "dataset": "node eval/dataset.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  }
}
